{
  "manifest_version": 3,
  "name": "沉淀 · 随手记",
  "version": "0.1.0",
  "description": "记下此刻的想法，收录正在阅读的网页。自己的 AI，自己的知识。",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "contextMenus",
    "alarms",
    "identity"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "打开沉淀随手记",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "side_panel": { "default_path": "panel.html" },
  "options_ui": { "page": "panel.html#settings", "open_in_tab": true },
  "commands": {
    "quick-note": {
      "suggested_key": { "default": "Alt+Shift+N" },
      "description": "随手记下一个想法"
    },
    "save-page": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "一键沉淀当前网页"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  }
}
