{
  "name": "sediment-knowledge-system",
  "private": true,
  "version": "4.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "server": "python server/app.py",
    "test": "python -m unittest discover -s tests -v",
    "prebuild": "python scripts/prepare-fonts.py",
    "test:ai": "vitest run",
    "test:browser": "python tests/browser_smoke.py",
    "predev": "python scripts/prepare-fonts.py",
    "test:browser:ai": "python tests/browser_ai.py",
    "test:browser:connect": "python tests/browser_connect.py",
    "test:auth": "vitest run tests/auth.test.tsx",
    "test:browser:auth": "node tests/browser_auth.mjs",
    "typecheck:extension": "tsc -p extension/tsconfig.json",
    "build:extension": "npm run typecheck:extension && node scripts/build-extension.mjs",
    "test:extension": "vitest run tests/extension.test.ts tests/ai.test.ts",
    "test:browser:extension": "node tests/browser_extension.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans": "^5.2.0",
    "@fontsource/inter": "^5.2.0",
    "@fontsource/literata": "^5.2.0",
    "@fontsource/lxgw-wenkai-mono-tc": "^5.3.0",
    "@fontsource/lxgw-wenkai-tc": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.2.0",
    "@fontsource/noto-serif-sc": "^5.2.0",
    "@fontsource/source-sans-3": "^5.2.0",
    "@fontsource/zcool-qingke-huangyou": "^5.2.0",
    "@fontsource/zcool-xiaowei": "^5.2.0",
    "@mozilla/readability": "0.6.0",
    "@types/chrome": "0.3.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/turndown": "5.0.6",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "26.1.0",
    "sharp": "0.34.5",
    "turndown": "7.2.4",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^5.0.3"
  }
}
